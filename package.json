{
  "name": "9health",
  "version": "1.0.0",
  "description": "9router Health Dashboard — standalone CLI & web companion app for monitoring AI model health, managing Combos, and detecting Context Window bottlenecks.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "9health": "./dist-server/server/cli.js"
  },
  "files": [
    "dist",
    "dist-server",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "9router",
    "9health",
    "ai",
    "llm",
    "health-check",
    "dashboard",
    "context-window",
    "openai-proxy",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/revanzk/9health.git"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/cli.js --no-open",
    "prepare": "node -e \"import('node:fs').then(async fs=>{if(fs.existsSync('node_modules/vite')&&!fs.existsSync('dist-server/server/cli.js')){const cp=await import('node:child_process');cp.execSync('npm run build',{stdio:'inherit'})}})\"",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}
